rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) 
                    && isValidId(userId)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // Chats subcollection
      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(chatId)
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 100;
        allow update: if isOwner(userId) 
                      && isValidId(chatId)
                      && request.resource.data.ownerId == resource.data.ownerId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 100;
        allow delete: if isOwner(userId) && isValidId(chatId);

        // Messages subcollection
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) 
                        && isValidId(messageId)
                        && request.resource.data.ownerId == request.auth.uid
                        && (request.resource.data.role == 'user' || request.resource.data.role == 'model')
                        && request.resource.data.content is string
                        && request.resource.data.content.size() <= 4000;
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }

      // LifeGraph Memories subcollection
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(memoryId)
                      && request.resource.data.ownerId == request.auth.uid;
        allow update: if isOwner(userId) 
                      && isValidId(memoryId)
                      && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      // Longitudinal Insights subcollection
      match /insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(insightId)
                      && request.resource.data.ownerId == request.auth.uid;
        allow update: if isOwner(userId) 
                      && isValidId(insightId)
                      && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isOwner(userId) && isValidId(insightId);
      }

      // Timeline events subcollection
      match /timeline/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(eventId)
                      && request.resource.data.ownerId == request.auth.uid;
        allow update: if isOwner(userId) 
                      && isValidId(eventId)
                      && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }
    }
  }
}
